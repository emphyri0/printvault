# Printvault settings. Copy to .env and fill in; .env is never committed.

# Required: a long random string for the session cookie, e.g. from:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Maximum upload size in MB
MAX_UPLOAD_MB=200

# Time zone for print start/end times and maintenance
PRINTVAULT_TZ=Europe/Brussels

# Camera (RTSPS printers): frames per second and maximum width of the live image
CAMERA_FPS=5
CAMERA_WIDTH=1280

# Number of reverse proxies in front of Printvault (0 = none, the default). With 1, the app takes the
# scheme and host from X-Forwarded-Proto and X-Forwarded-Host (e.g. https://printvault.example), so
# absolute links are right. Only set this when the app is reachable ONLY through that proxy.
TRUSTED_PROXIES=0

# User and group the containers run as (owner of ./data); defaults to 1000:1000
# UID=1000
# GID=1000
